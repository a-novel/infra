[Unit]
Description=Agora ${service} database (foundation maintenance only)
BindsTo=docker.service
Wants=network-online.target gcr-online.target
%{ if backup_timers != "" ~}
Wants=${backup_timers}
%{ endif ~}
After=docker.service network-online.target gcr-online.target
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=notify
NotifyAccess=all
Restart=on-failure
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=90
UMask=0077
RuntimeDirectory=agora
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=no
Environment=PGBACKREST_REPOSITORY_NAME=${server_name}
Environment=PGBACKREST_REPOSITORY_IP=${server_ip}
Environment=PGBACKREST_WAL_ARCHIVING=${wal_archiving}
Environment=PGBACKREST_DATABASE_IMAGE=${server_image}
ExecStartPre=/usr/bin/docker --config=/etc/agora-database/docker pull ${credentials_image}
ExecStartPre=/usr/bin/docker --config=/etc/agora-database/docker pull ${server_image}
ExecStartPre=/usr/bin/install -d -o 999 -g 999 -m 0700 /run/agora/pgbackrest /run/agora/postgresql /run/agora/pgbackrest-lock
ExecStartPre=/usr/bin/docker run --rm --name=agora-database-credentials --pull=never \
    --network=host --read-only --user=999:999 --cap-drop=ALL --security-opt=no-new-privileges \
    --cpus=1 --memory=256m --pids-limit=64 --no-healthcheck --log-driver=none --ulimit=core=0 \
    --mount=type=bind,source=/run/agora/pgbackrest,target=/credentials \
    ${credentials_image} --management-project-number=${management_number} --workload-project=${project} \
    --service=${service} --endpoint=database ${zone_argument}--ca-version=${ca_version} --identity-version=${identity_version} \
    --name=${client_name} --output=/credentials/current
ExecStart=/bin/bash /etc/agora-database/startup.sh --supervise
ExecStop=/usr/bin/docker stop --time=60 agora-postgres-${service}
# Reap interrupted startup too; systemd removes credentials only after consumers stop.
ExecStopPost=-/usr/bin/docker kill ${backup_containers}
ExecStopPost=-/usr/bin/docker rm --force agora-database-credentials agora-postgres-${service}
