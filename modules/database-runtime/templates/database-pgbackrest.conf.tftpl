[global]
repo1-host=${server_name}
repo1-host-type=tls
repo1-host-port=8432
repo1-host-ca-file=/run/pgbackrest/ca.pem
repo1-host-cert-file=/run/pgbackrest/identity.pem
repo1-host-key-file=/run/pgbackrest/identity.pem
repo1-path=/${service}
repo1-retention-full-type=time
repo1-retention-full=14
expire-auto=y
lock-path=/run/pgbackrest-lock
process-max=1
log-level-console=info
log-level-file=off

[${service}]
pg1-path=/var/lib/postgresql/18/docker
pg1-socket-path=/var/run/postgresql
pg1-user=${database}
pg1-database=${database}
