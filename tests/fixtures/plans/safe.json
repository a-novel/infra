{
  "format_version": "1.2",
  "terraform_version": "1.12.6",
  "variables": {
    "database_password": {
      "value": "fixture-secret-must-not-be-printed"
    }
  },
  "resource_changes": [
    {
      "address": "google_cloud_run_v2_service.authentication",
      "mode": "managed",
      "type": "google_cloud_run_v2_service",
      "name": "authentication",
      "change": {
        "actions": ["update"],
        "before": {
          "dsn": "postgres://fixture-user:fixture-password@database/internal"
        },
        "after": {
          "dsn": "postgres://fixture-user:changed-password@database/internal"
        }
      }
    },
    {
      "address": "google_cloud_run_v2_job.authentication_migrations",
      "mode": "managed",
      "type": "google_cloud_run_v2_job",
      "name": "authentication_migrations",
      "change": {
        "actions": ["create"],
        "before": null,
        "after": {
          "token": "fixture-token-must-not-be-printed"
        }
      }
    },
    {
      "address": "google_storage_bucket.unchanged",
      "mode": "managed",
      "type": "google_storage_bucket",
      "name": "unchanged",
      "change": {
        "actions": ["no-op"],
        "before": {
          "name": "fixture-no-op-resource"
        },
        "after": {
          "name": "fixture-no-op-resource"
        }
      }
    },
    {
      "address": "google_project.workload",
      "mode": "managed",
      "type": "google_project",
      "name": "workload",
      "change": {
        "actions": ["no-op"],
        "before": {
          "project_id": "fixture-imported-project"
        },
        "after": {
          "project_id": "fixture-imported-project"
        },
        "importing": {
          "id": "fixture-import-id-must-not-be-printed"
        }
      }
    }
  ]
}
