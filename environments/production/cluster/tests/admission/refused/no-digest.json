{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "admission-check"
  },
  "spec": {
    "securityContext": {
      "runAsNonRoot": true,
      "seccompProfile": {
        "type": "RuntimeDefault"
      }
    },
    "containers": [
      {
        "name": "check",
        "image": "europe-west1-docker.pkg.dev/a-novel-production-prod/a-novel-ghcr-io/cloudnative-pg/cloudnative-pg:1.30.1",
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": ["ALL"]
          },
          "readOnlyRootFilesystem": true
        }
      }
    ]
  }
}
