[Unit]
Description=Agora JSON Keys native backup repository
BindsTo=docker.service
Wants=network-online.target gcr-online.target
After=docker.service network-online.target gcr-online.target

[Service]
Type=exec
Restart=${restart}
RestartSec=30
TimeoutStartSec=240
TimeoutStopSec=60
UMask=0077
RuntimeDirectory=agora-backup-repository
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=no
ExecStartPre=/usr/bin/docker --config=/etc/agora-backup/docker pull ${credentials_image}
ExecStartPre=/usr/bin/docker --config=/etc/agora-backup/docker pull ${server_image}
ExecStartPre=/usr/bin/install -d -o 999 -g 999 -m 0700 /run/agora-backup-repository/credentials
ExecStartPre=/usr/bin/docker run --rm --name=agora-backup-credentials --pull=never \
    --network=host --read-only --user=999:999 --cap-drop=ALL --security-opt=no-new-privileges \
    --cpus=1 --memory=256m --pids-limit=64 --no-healthcheck --log-driver=none \
    --ulimit=core=0 --mount=type=bind,source=/run/agora-backup-repository/credentials,target=/credentials \
    ${credentials_image} --management-project-number=${management_number} --workload-project=${project} \
    --endpoint=repository ${zone_argument}--ca-version=${ca_version} --identity-version=${identity_version} \
    --name=${server_name} --output=/credentials/current
# COS blocks host-network listeners; VPC rules restrict this port to the database identity.
ExecStartPre=/sbin/iptables -w 5 -I INPUT 1 -p tcp --dport 8432 -m comment --comment agora-backup-repository -j ACCEPT
ExecStart=/usr/bin/docker run --rm --name=agora-backup-repository --pull=never \
    --network=host --read-only --user=999:999 --cap-drop=ALL --security-opt=no-new-privileges \
    --cpus=1 --memory=384m --pids-limit=64 --no-healthcheck --log-driver=none --ulimit=core=0 \
    --tmpfs=/tmp:rw,noexec,nosuid,nodev,size=32m,mode=1777 \
    --mount=type=bind,source=/run/agora-backup-repository/credentials/current,target=/run/credentials,readonly \
    --mount=type=bind,source=/etc/agora-backup/pgbackrest.conf,target=/etc/pgbackrest/pgbackrest.conf,readonly \
    --entrypoint=pgbackrest ${server_image} server
ExecStop=/usr/bin/docker stop --time=30 agora-backup-repository
ExecStopPost=-/sbin/iptables -w 5 -D INPUT -p tcp --dport 8432 -m comment --comment agora-backup-repository -j ACCEPT
# Also reap a loader interrupted before ExecStart; systemd then removes RuntimeDirectory.
ExecStopPost=-/usr/bin/docker rm --force agora-backup-credentials agora-backup-repository
