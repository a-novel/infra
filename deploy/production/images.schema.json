{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/a-novel/infra/deploy/production/images.schema.json",
  "title": "Agora production image manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "components"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service-json-keys", "service-authentication"],
      "properties": {
        "service-json-keys": {
          "$ref": "#/$defs/component"
        },
        "service-authentication": {
          "$ref": "#/$defs/component"
        }
      }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "images"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "images": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(database|grpc|rest|jobs/[a-z0-9-]+)$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/image"
          }
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "images": {
            "type": "object",
            "minProperties": 1
          }
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^ghcr\\.io/a-novel/(service-json-keys|service-authentication)/(database|grpc|rest|jobs/[a-z0-9-]+)$"
        },
        "tag": {
          "type": "string",
          "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    }
  }
}
