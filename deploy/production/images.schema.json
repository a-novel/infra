{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/a-novel/infra/deploy/production/images.schema.json",
  "title": "Agora production image manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "postgresMajor", "components"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "postgresMajor": {
      "const": 18
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service-json-keys", "service-authentication"],
      "properties": {
        "service-json-keys": {
          "$ref": "#/$defs/jsonKeysComponent"
        },
        "service-authentication": {
          "$ref": "#/$defs/authenticationComponent"
        }
      }
    }
  },
  "$defs": {
    "jsonKeysComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "images"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "images": {
          "type": "object"
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "images": {
            "$ref": "#/$defs/jsonKeysImages"
          }
        }
      },
      "else": {
        "properties": {
          "images": {
            "$ref": "#/$defs/disabledImages"
          }
        }
      }
    },
    "authenticationComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "images"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "images": {
          "type": "object"
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "images": {
            "$ref": "#/$defs/authenticationImages"
          }
        }
      },
      "else": {
        "properties": {
          "images": {
            "$ref": "#/$defs/disabledImages"
          }
        }
      }
    },
    "jsonKeysImages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["database", "grpc", "jobs/migrations", "jobs/rotatekeys"],
      "properties": {
        "database": {
          "$ref": "#/$defs/image",
          "type": "object",
          "properties": {
            "repository": {
              "const": "ghcr.io/a-novel/service-json-keys/database"
            }
          }
        },
        "grpc": {
          "$ref": "#/$defs/image",
          "type": "object",
          "properties": {
            "repository": {
              "const": "ghcr.io/a-novel/service-json-keys/grpc"
            }
          }
        },
        "jobs/migrations": {
          "$ref": "#/$defs/image",
          "type": "object",
          "properties": {
            "repository": {
              "const": "ghcr.io/a-novel/service-json-keys/jobs/migrations"
            }
          }
        },
        "jobs/rotatekeys": {
          "$ref": "#/$defs/image",
          "type": "object",
          "properties": {
            "repository": {
              "const": "ghcr.io/a-novel/service-json-keys/jobs/rotatekeys"
            }
          }
        }
      }
    },
    "authenticationImages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["database", "jobs/init", "jobs/migrations", "rest"],
      "properties": {
        "database": {
          "$ref": "#/$defs/image",
          "type": "object",
          "properties": {
            "repository": {
              "const": "ghcr.io/a-novel/service-authentication/database"
            }
          }
        },
        "jobs/init": {
          "$ref": "#/$defs/image",
          "type": "object",
          "properties": {
            "repository": {
              "const": "ghcr.io/a-novel/service-authentication/jobs/init"
            }
          }
        },
        "jobs/migrations": {
          "$ref": "#/$defs/image",
          "type": "object",
          "properties": {
            "repository": {
              "const": "ghcr.io/a-novel/service-authentication/jobs/migrations"
            }
          }
        },
        "rest": {
          "$ref": "#/$defs/image",
          "type": "object",
          "properties": {
            "repository": {
              "const": "ghcr.io/a-novel/service-authentication/rest"
            }
          }
        }
      }
    },
    "disabledImages": {
      "type": "object",
      "maxProperties": 0
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest"],
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string",
          "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    }
  }
}
