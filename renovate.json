{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>a-novel-kit/workflows//renovate/infra#v1.42.0",
    ":semanticCommits"
  ],
  "rangeStrategy": "pin",
  "ignoreUnstable": true,
  "gomod": {
    "managerFilePatterns": ["/^golangci-lint\\.mod$/"]
  },
  "packageRules": [
    {
      "description": "Keep tooling images on version tags; production service images carry their digest beside the tag.",
      "matchDatasources": ["docker"],
      "pinDigests": false
    },
    {
      "description": "Resolve Terraform providers and modules from the registry used by OpenTofu.",
      "matchDatasources": ["terraform-provider", "terraform-module"],
      "registryUrls": ["https://registry.opentofu.org"]
    },
    {
      "description": "Review the stable Google provider and service-agent beta provider together.",
      "matchManagers": ["terraform"],
      "matchPackageNames": ["hashicorp/google", "hashicorp/google-beta"],
      "groupName": "Google providers",
      "automerge": false
    },
    {
      "description": "Keep GitHub Actions on complete stable SemVer tags.",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["!a-novel-kit/workflows"],
      "pinDigests": false
    },
    {
      "description": "Keep the shared workflow actions on one reviewed release tag.",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["a-novel-kit/workflows"],
      "groupName": "a-novel-kit workflows",
      "pinDigests": false
    },
    {
      "description": "Resolve Aqua Security tags directly from Git because its organization IP allow list rejects authenticated GitHub GraphQL lookups.",
      "matchPackageNames": ["aquasecurity/trivy", "aquasecurity/trivy-action"],
      "overrideDatasource": "git-tags",
      "overridePackageName": "https://github.com/{{{packageName}}}",
      "versioning": "semver"
    },
    {
      "description": "Accept only complete stable SemVer tags for production service images.",
      "matchDatasources": ["docker"],
      "matchFileNames": ["environments/production/*/terraform.tfvars"],
      "allowedVersions": "/^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$/",
      "versioning": "semver",
      "automerge": false
    },
    {
      "description": "Update the JSON Keys image family as one release.",
      "matchDatasources": ["docker"],
      "matchFileNames": ["environments/production/*/terraform.tfvars"],
      "matchPackageNames": ["ghcr.io/a-novel/service-json-keys/**"],
      "groupName": "service-json-keys images",
      "minimumGroupSize": 3,
      "groupSlug": "service-json-keys-images",
      "separateMajorMinor": true
    },
    {
      "description": "Update the Authentication image family as one release.",
      "matchDatasources": ["docker"],
      "matchFileNames": ["environments/production/*/terraform.tfvars"],
      "matchPackageNames": ["ghcr.io/a-novel/service-authentication/**"],
      "groupName": "service-authentication images",
      "minimumGroupSize": 2,
      "groupSlug": "service-authentication-images",
      "separateMajorMinor": true
    },
    {
      "description": "Propose database images in their own pull request: merging updates the host templates, and rolling the hosts is a separate manual step.",
      "matchDatasources": ["docker"],
      "matchFileNames": ["environments/production/*/terraform.tfvars"],
      "matchPackageNames": ["ghcr.io/a-novel/*/database"],
      "groupName": "database images",
      "groupSlug": "database-images",
      "minimumGroupSize": 1
    },
    {
      "description": "Let the OpenTofu managers own required_version instead of treating it as HashiCorp Terraform.",
      "matchPackageNames": ["hashicorp/terraform"],
      "enabled": false
    },
    {
      "description": "Keep the OpenTofu binary and root constraints on one version.",
      "matchPackageNames": ["opentofu/opentofu"],
      "groupName": "OpenTofu",
      "automerge": false
    },
    {
      "description": "Hold OpenTofu and provider releases for a week. Pull-request plans run the new binaries with the read-only production identity, so the release age bounds a compromised upstream release.",
      "matchFileNames": [".opentofu-version", "**/versions.tf"],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Let patch releases through after six hours so fixes land quickly. Renovate classifies each candidate against the current version, so a release that changes the minor or major version keeps the week-long hold even when it is itself a patch, such as 1.1.2 to 1.2.2.",
      "matchFileNames": [".opentofu-version", "**/versions.tf"],
      "matchUpdateTypes": ["patch"],
      "minimumReleaseAge": "6 hours"
    },
    {
      "description": "Refresh the host programs' module with the native Go manager.",
      "matchManagers": ["gomod"],
      "matchFileNames": ["go.mod"],
      "postUpdateOptions": ["gomodTidy"]
    },
    {
      "description": "Hold google.golang.org/api off v0.299.0 because its module graph forces vulnerable gRPC v1.84.0; admit the first later release.",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["google.golang.org/api"],
      "allowedVersions": "<0.299.0 || >0.299.0"
    },
    {
      "description": "Resolve only declared tools in the isolated linter module, on separate branches from runtime dependencies.",
      "matchManagers": ["gomod"],
      "matchFileNames": ["golangci-lint.mod"],
      "additionalBranchPrefix": "golangci-lint-",
      "goGetDirs": ["tool"]
    },
    {
      "description": "Require review for production configuration and infrastructure definitions.",
      "matchFileNames": [
        "bootstrap/**",
        "environments/production/**",
        "**/*.tf",
        "**/*.tf.json",
        "**/*.tofu",
        "**/*.tofu.json",
        "**/.terraform.lock.hcl"
      ],
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the OpenTofu version file.",
      "managerFilePatterns": ["/^\\.opentofu-version$/"],
      "matchStrings": ["(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"],
      "depNameTemplate": "opentofu/opentofu",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Keep each root's OpenTofu constraint aligned with the version file.",
      "managerFilePatterns": ["/(^|/)versions\\.tf$/"],
      "matchStrings": [
        "# renovate: datasource=github-releases depName=opentofu/opentofu\\s+required_version\\s*=\\s*\"= (?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""
      ],
      "depNameTemplate": "opentofu/opentofu",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update pinned workflow tool versions declared beside Renovate metadata.",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)\\s+(?:[a-z_]+_)?version\\s*[:=]\\s*[\"']?(?<currentValue>v?[0-9]+\\.[0-9]+\\.[0-9]+)[\"']?"
      ]
    },
    {
      "customType": "regex",
      "description": "Update production service images pinned as tag@digest.",
      "managerFilePatterns": [
        "/^environments/production/[^/]+/terraform\\.tfvars$/"
      ],
      "matchStrings": [
        "\"(?<depName>ghcr\\.io/a-novel/[^:\"]+):(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    }
  ]
}
