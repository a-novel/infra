{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>a-novel-kit/workflows//renovate/infra#v1.81.3",
    ":semanticCommits"
  ],
  "rangeStrategy": "pin",
  "ignoreUnstable": true,
  "packageRules": [
    {
      "description": "Keep tooling images on version tags; production service images carry their digest beside the tag.",
      "matchDatasources": ["docker"],
      "pinDigests": false
    },
    {
      "description": "Leave first-party release images to pin-release.yaml: each release dispatches it once all its images are published, so no update pins half a release.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/a-novel/**"],
      "enabled": false
    },
    {
      "description": "Resolve Terraform providers and modules from the registry used by OpenTofu.",
      "matchDatasources": ["terraform-provider", "terraform-module"],
      "registryUrls": ["https://registry.opentofu.org"]
    },
    {
      "description": "Review the stable Google provider and service-agent beta provider together.",
      "matchManagers": ["terraform"],
      "matchPackageNames": ["hashicorp/google", "hashicorp/google-beta"],
      "groupName": "Google providers",
      "automerge": false
    },
    {
      "description": "Resolve Aqua Security tags directly from Git because its organization IP allow list rejects authenticated GitHub GraphQL lookups.",
      "matchPackageNames": ["aquasecurity/trivy", "aquasecurity/trivy-action"],
      "overrideDatasource": "git-tags",
      "overridePackageName": "https://github.com/{{{packageName}}}",
      "versioning": "semver"
    },
    {
      "description": "Let the OpenTofu managers own required_version instead of treating it as HashiCorp Terraform.",
      "matchPackageNames": ["hashicorp/terraform"],
      "enabled": false
    },
    {
      "description": "Keep the OpenTofu binary and root constraints on one version.",
      "matchPackageNames": ["opentofu/opentofu"],
      "groupName": "OpenTofu",
      "automerge": false
    },
    {
      "description": "Hold OpenTofu and provider releases for a week. Pull-request plans run the new binaries with the read-only production identity, and an update that merges on its own deploys them, so the release age bounds a compromised upstream release.",
      "matchFileNames": [".opentofu-version", "**/versions.tf"],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Let patch releases through after six hours so fixes land quickly. Renovate classifies each candidate against the current version, so a release that changes the minor or major version keeps the week-long hold even when it is itself a patch, such as 1.1.2 to 1.2.2.",
      "matchFileNames": [".opentofu-version", "**/versions.tf"],
      "matchUpdateTypes": ["patch"],
      "minimumReleaseAge": "6 hours"
    },
    {
      "description": "Hold the cluster add-ons' charts and images for a week, as provider releases are held, to bound a compromised upstream release.",
      "matchFileNames": [
        "environments/production/cluster/**",
        "modules/database-operator/**"
      ],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Move cert-manager's chart and images in one pull request, since the chart expects its own images.",
      "matchFileNames": [
        "environments/production/cluster/**",
        "modules/database-operator/**"
      ],
      "matchPackageNames": ["cert-manager", "quay.io/jetstack/**"],
      "groupName": "cert-manager"
    },
    {
      "description": "Move trust-manager's chart and image in their own pull request, apart from cert-manager's, whose rule matches the image too.",
      "matchFileNames": ["environments/production/cluster/**"],
      "matchPackageNames": ["trust-manager", "quay.io/jetstack/trust-manager"],
      "groupName": "trust-manager"
    },
    {
      "description": "Move CloudNativePG's chart and images in one pull request, since the chart expects its own images.",
      "matchFileNames": [
        "environments/production/cluster/**",
        "modules/database-operator/**"
      ],
      "matchPackageNames": [
        "cloudnative-pg",
        "ghcr.io/cloudnative-pg/cloudnative-pg"
      ],
      "groupName": "CloudNativePG"
    },
    {
      "description": "Move Barman Cloud plugin's chart and images in one pull request, since the chart expects its own images.",
      "matchFileNames": [
        "environments/production/cluster/**",
        "modules/database-operator/**"
      ],
      "matchPackageNames": [
        "plugin-barman-cloud",
        "ghcr.io/cloudnative-pg/plugin-barman-cloud",
        "ghcr.io/cloudnative-pg/plugin-barman-cloud-sidecar"
      ],
      "groupName": "Barman Cloud plugin"
    },
    {
      "description": "Move External Secrets's chart and images in one pull request, since the chart expects its own images.",
      "matchFileNames": [
        "environments/production/cluster/**",
        "modules/database-operator/**"
      ],
      "matchPackageNames": [
        "external-secrets",
        "ghcr.io/external-secrets/external-secrets"
      ],
      "groupName": "External Secrets"
    },
    {
      "description": "Move the k8s-monitoring chart with the images it runs in one pull request, since the chart pins its own versions of them.",
      "matchFileNames": ["environments/production/cluster/**"],
      "matchPackageNames": [
        "k8s-monitoring",
        "docker.io/grafana/alloy",
        "ghcr.io/grafana/alloy-operator",
        "quay.io/prometheus-operator/prometheus-config-reloader",
        "registry.k8s.io/kube-state-metrics/kube-state-metrics"
      ],
      "groupName": "k8s-monitoring"
    },
    {
      "description": "Move the Valkey chart with the server and exporter images it runs in one pull request, since the chart pins its own versions of them.",
      "matchFileNames": ["environments/production/cluster/**"],
      "matchPackageNames": [
        "valkey",
        "docker.io/valkey/valkey",
        "ghcr.io/oliver006/redis_exporter"
      ],
      "groupName": "Valkey"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the OpenTofu version file.",
      "managerFilePatterns": ["/^\\.opentofu-version$/"],
      "matchStrings": ["(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"],
      "depNameTemplate": "opentofu/opentofu",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Keep each root's OpenTofu constraint aligned with the version file.",
      "managerFilePatterns": ["/(^|/)versions\\.tf$/"],
      "matchStrings": [
        "# renovate: datasource=github-releases depName=opentofu/opentofu\\s+required_version\\s*=\\s*\"= (?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""
      ],
      "depNameTemplate": "opentofu/opentofu",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update pinned workflow tool versions declared beside Renovate metadata.",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)\\s+(?:[a-z_]+_)?version\\s*[:=]\\s*[\"']?(?<currentValue>v?[0-9]+\\.[0-9]+\\.[0-9]+)[\"']?"
      ]
    },
    {
      "customType": "regex",
      "description": "Update the cluster add-ons' images, each pinned by digest beside its tag.",
      "managerFilePatterns": [
        "/^environments/production/cluster/terraform\\.tfvars$/"
      ],
      "matchStrings": [
        "\"(?<depName>(?:docker\\.io|ghcr\\.io|quay\\.io|registry\\.k8s\\.io)/[^:\"]+):(?<currentValue>[^@\"]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
