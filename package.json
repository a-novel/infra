  "dependencies": {
    "ajv": "8.20.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "renovate": "44.83.0"
  },
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": "24.21.0",
    "pnpm": "12.4.2"
  }
}
