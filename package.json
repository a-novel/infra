{
  "name": "@a-novel/infra-tooling",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "format": "pnpm format:go && pnpm format:prettier",
    "format:go": "go tool -modfile=golangci-lint.mod golangci-lint fmt",
    "format:prettier": "prettier --no-config --no-editorconfig --write .",
    "lint": "pnpm lint:go && pnpm lint:config",
    "lint:go": "go tool -modfile=golangci-lint.mod golangci-lint run ./...",
    "lint:config": "pnpm lint:stylecheck && pnpm lint:renovate",
    "lint:renovate": "renovate-config-validator --strict",
    "lint:stylecheck": "prettier --no-config --no-editorconfig --check ."
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "renovate": "44.110.0"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "24.21.0",
    "pnpm": "12.6.0"
  }
}
