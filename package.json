{
  "name": "@a-novel/infra-tooling",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --no-config --no-editorconfig --write .",
    "lint": "pnpm lint:stylecheck && pnpm lint:renovate",
